{
  "compilerOptions": {
    "target": "es2020",                          /* Especifica la versión de ECMAScript destino */
    "module": "commonjs",                         /* Especifica el sistema de módulos del código generado */
    "outDir": "./dist",                           /* Directorio de salida para los archivos .js compilados */
    "rootDir": "./src",                           /* Directorio raíz de los archivos de entrada .ts */
    "strict": true,                               /* Activa todas las opciones de tipo estricto */
    "esModuleInterop": true,                      /* Permite la interoperabilidad con módulos CommonJS */
    "skipLibCheck": true,                         /* Omite la comprobación de tipos de los archivos de declaración */
    "forceConsistentCasingInFileNames": true,     /* Asegura que las mayúsculas y minúsculas sean consistentes en los nombres de archivo */
    "resolveJsonModule": true                     /* Permite importar módulos .json */
  },
  "include": [
    "src/**/*"                                    /* Incluye todos los archivos dentro de la carpeta src */
  ],
  "exclude": [
    "node_modules",                               /* Excluye el directorio node_modules */
    "**/*.spec.ts"                                /* Excluye los archivos de prueba */
  ]
}
